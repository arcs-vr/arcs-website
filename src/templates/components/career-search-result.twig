<div class="job-image d-none d-sm-block">
    <img
      src="{{ image.source }}"
      alt="{{ image.alt }}"
    >
</div>
<div class="job-content-wrapper d-flex flex-column w-100">
    <div class="job-title mb-3">
        {{ title|raw }}
    </div>
    <div class="job-info mb-2"><span class="job-company mr-3">{{ company }}</span>
        <span
          class="job-address"
        >
                <i class="icon icon--marker"></i>{{ location }}
            </span>
    </div>
    <div class="job-tags tags">
        {% for tag in tags %}
            <span class="tag">{{ tag }}</span>
        {% endfor %}
    </div>
</div>