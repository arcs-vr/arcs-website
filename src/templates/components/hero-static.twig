<header class="hero--static">
    <div class="container">
        <div class="row">
            <div class="col col-lg-8">
                <div class="hero--static__text">
                    <h1>{% block heading %}{% endblock %}</h1>
                    {% block additional %}{% endblock %}
                </div>
            </div>
        </div>
        <div
          class="hero--static__image {% if noBow %}no-Bow{% endif %} {% if mobileTransparent %}mobile-transparent{% endif %}"
          style="background-image: url({% block img %}{% endblock %})"
        >
        </div>
    </div>
</header>
