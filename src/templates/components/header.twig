<header class="header">
    <div class="container h-100">
        <div class="navbar header-inner">
            <div class="d-flex">
                <button
                  class="navbar-toggle collapsed mobile-nav-button navbar-toggler d-xl-none pl-0"
                  id="mobile-nav-button"
                  type="button"
                  data-toggle="collapse"
                  data-target="#mobilenav"
                  aria-controls="mobilenav"
                  aria-expanded="false"
                  aria-label="Toggle navigation"
                >
                    <span class="sr-only">Toggle navigation</span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a
                  href="/"
                  class="logo"
                >
                    <img
                      src="../../images/img/design/logo.svg"
                      alt="CleverMatch"
                    >
                </a>
                <div class="shopping-cart-button-mobile d-xl-none"></div>
                <div class="main-nav d-none d-xl-flex">
                    <nav>
                        <ul>
                            <li>
                                <a
                                  class="collapsed"
                                  role="button"
                                  data-toggle="collapse"
                                  href="#main-navigation-second"
                                  aria-expanded="false"
                                  aria-controls="main-navigation-second"
                                >Shop
                                </a>
                            </li>
                            <li>
                                <a href="#">Vorteile</a>
                            </li>
                            <li>
                                <a href="#">Unsere Idee</a>
                            </li>
                            <li>
                                <a href="#">Support</a>
                            </li>
                            <li>
                                <a class="btn btn-navi" href="#">Live Demo</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
            <div class="header__right d-none d-xl-flex flex-column">
                <div class="row align-items-center header__right__top">
                    <label
                      class="sr-only"
                      for="language-switcher"
                    >
                        Sprache Wählen
                    </label>
                    <div class="language-switcher">
                        <select
                          class=""
                          name="language-switcher"
                          id="language-switcher"
                        >
                            <option
                              value="DE"
                              selected
                            >DE
                            </option>
                            <option value="EN">EN</option>
                        </select>
                    </div>
                    {% if logged_in %}
                        <div class="text-right">
                            <a
                              class="login-link font-weight-normal"
                              href="#"
                            >Angemeldet als:
                            </a>
                            <div class="d-block">
                                <strong>MAX MUSTERMANN</strong>
                            </div>
                        </div>
                    {% else %}
                        <a
                          class="login-link"
                          href="#"
                        >Anmelden
                        </a>
                    {% endif %}
                    <div class="shopping-cart-wrapper">
                        <div class="shopping-cart-button shopping-cart-button-outlined">
                            <span class="label">Warenkorb</span>
                            <span class="items">(4)</span>
                            <span class="total-price">3999,-€</span>
                            <span class="shopping-list-toggler">X</span>
                        </div>
                    </div>
                    <div class="shopping-cart-wrapper">
                        <div class="shopping-cart-button shopping-cart-button-blue">
                            <span class="label"><i class="fas fa-phone fa-flip-horizontal"></i> +49 69 678 305 840</span>
                        </div>
                    </div>
                </div>
                <div class="row align-items-center ml-auto header__right__bottom">
                    <div class="input-group mb-3 header__search">
                        <div class="input-group-prepend">
                                <span
                                  class="input-group-text"
                                  id="basic-addon1"
                                >Suchen | </span>
                        </div>
                        <input
                          type="text"
                          class="form-control"
                          aria-label="Username"
                          aria-describedby="basic-addon1"
                        ><i class="fas fa-search text-brand-blue ml-1"></i>
                    </div>
                </div>
                {# <div class="row ">
                    <div class="col-12">

                        <div class="input-group mb-3">
                            <div class="input-group-prepend">
                                <span
                                  class="input-group-text"
