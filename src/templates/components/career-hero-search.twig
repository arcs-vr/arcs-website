<div class="hero-search d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col">
                <div class="inner">
                    <div class="headline mb-3">Finden Sie den passenden Job. Weltweit.</div>
                    <form
                      action="/"
                      class="w-100"
                    >
                        <div class="form-wrapper career-tworow flex-column flex-lg-row">
                            <div class="form-group career-tworow-group form-group--text mr-lg-2">
                                <label
                                  for="what"
                                  class="form-label"
                                >
                                    Was?
                                </label>
                                <input
                                  type="text"
                                  placeholder="Jobtitel oder Firmenname"
                                  name="what"
                                  id="what"
                                >
                            </div>
                            <div class="form-group career-tworow-group form-group--text mr-lg-2">
                                <label
                                  for="location"
                                  class="form-label"
                                >
                                    Wo?
                                </label>
                                <input
                                  type="text"
                                  placeholder="Land / Ort / PLZ"
                                  name="location"
                                  id="location"
                                >
                            </div>
                            <div class="form-group career-tworow-group form-group--select mr-lg-2">
                                <label
                                  for="radius"
                                  class="form-label"
                                >
                                    Radius
                                </label>
                                <select
                                  type="text"
                                  name="radius"
                                  id="radius"
                                >
                                    <option value="5">5 km</option>
                                    <option value="10">10 km</option>
                                    <option value="20">20 km</option>
                                    <option value="50">50 km</option>
                                </select>
                            </div>
                            <button
                              class="btn career-tworow-group btn-primary btn-dark-blue"
                              type="submit"
                            >
                                Filter anwenden
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
